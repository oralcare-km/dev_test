#DirectoryIndex index.html index.htm index.shtml index.php index.cgi
#Options -Indexes
#AuthUserFile /home/oralcare-web/www/plaut/.htpasswd
#AuthType Basic
#AuthName "Web access"
#Satisfy all
#Order deny,allow


<IfModule mod_rewrite.c>

RewriteEngine on

RewriteCond %{HTTP_HOST} !^www\.
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # 画像ファイルのみ（変更頻度が低めのアセット）を1年キャッシュ
  ExpiresByType image/jpeg  "access plus 1 year"
  ExpiresByType image/png   "access plus 1 year"
  ExpiresByType image/gif   "access plus 1 year"
  ExpiresByType image/webp  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # HTTPS接続時のみ、HSTSヘッダを付与する
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Referrer-Policy を設定
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # CSP（実サイト向け：GTM / GA / Clarity / Google Fonts / GSAP）
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://scripts.clarity.ms https://www.clarity.ms https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://www.google.com https://analytics.google.com https://www.google-analytics.com https://region1.google-analytics.com https://*.googleadservices.com https://www.clarity.ms https://*.clarity.ms; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests;"

  <FilesMatch "\.(jpe?g|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.xml$">
        Header set Content-Type "text/xml; charset=UTF-8"
  </FilesMatch>

  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>